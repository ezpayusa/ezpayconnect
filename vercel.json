{
  "rewrites": [
    { "source": "/t/(.*)", "destination": "https://fqnsmvkxsuujahhmpzuk.supabase.co/functions/v1/tarjeta-asesor?token=$1" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
